{
  "name": "finance-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,ui -c blue,green \"npm:dev:server\" \"npm:dev:ui\"",
    "dev:ui": "vite",
    "dev:server": "tsx watch server/index.ts",
    "dev:mock": "VITE_DATA_SOURCE=mock vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "node scripts/test.mjs",
    "check": "npm run lint && npm test -- --runInBand && npm run build"
  },
  "dependencies": {
    "express": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0",
    "yahoo-finance2": "^3.15.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.6",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "tsx": "^4.23.15",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.7",
    "vitest": "^3.2.7"
  }
}
